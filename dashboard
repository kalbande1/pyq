<!DOCTYPE html>
<html lang="mr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>सराव पेपर्स — पोलीस भरती पोर्टल</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.49.1/dist/umd/supabase.min.js"></script>
  <link rel="stylesheet" href="styles.css" />
</head>
<body class="min-h-screen flex flex-col">

  <header class="bg-white border-b border-slate-200 sticky top-0 z-30">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3">
      <div class="truncate">
        <h1 class="text-sm sm:text-base font-bold text-slate-900 truncate">पोलीस भरती सराव पोर्टल</h1>
        <p id="user-sub" class="text-xs text-slate-500 truncate"></p>
      </div>
      <nav class="flex items-center gap-2 shrink-0">
        <a href="dashboard.html" class="px-3 py-1.5 text-xs sm:text-sm font-semibold text-blue-900 bg-blue-50 rounded-lg">सराव पेपर्स</a>
        <a href="profile.html" class="px-3 py-1.5 text-xs sm:text-sm font-medium text-slate-700 hover:bg-slate-100 rounded-lg">माझे प्रोफाईल</a>
        <a id="admin-link" href="admin.html" class="hidden px-3 py-1.5 text-xs font-semibold text-amber-900 bg-amber-50 border border-amber-200 rounded-lg">अ‍ॅडमिन</a>
        <button id="btn-logout" type="button" class="px-3 py-1.5 text-xs font-medium text-slate-600 hover:text-rose-700 border border-slate-200 rounded-lg">लॉगआउट</button>
      </nav>
    </div>
  </header>

  <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="text-xl font-bold text-slate-900">उपलब्ध प्रश्नपत्रिका</h2>
        <p class="text-xs text-slate-500">सोडवलेले पेपर्स, मार्क्स आणि प्रगती ग्राफ पाहण्यासाठी वरच्या <strong>माझे प्रोफाईल</strong> वर क्लिक करा.</p>
      </div>
      <a href="profile.html" class="px-4 py-2 text-xs font-semibold bg-white border border-slate-300 hover:bg-slate-50 text-slate-800 rounded-lg">
        माझे प्रोफाईल व प्रगती ग्राफ →
      </a>
    </div>

    <div id="papers-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
  </main>

  <script src="config.js"></script>
  <script>
    document.getElementById('btn-logout').addEventListener('click', () => api.logout());

    (async function init() {
      const user = await api.requireAuth();
      if (!user) return;
      document.getElementById('user-sub').textContent = user.full_name + ' • ' + user.bharti_type;
      if (user.role === 'admin') document.getElementById('admin-link').classList.remove('hidden');

      const { papers, attempts } = await api.getStudentDashboard(user.id);
      const grid = document.getElementById('papers-grid');
      if (papers.length === 0) {
        grid.innerHTML = '<div class="col-span-full bg-white border border-slate-200 rounded-xl p-8 text-center text-sm text-slate-500">सध्या कोणताही पेपर उपलब्ध नाही.</div>';
        return;
      }

      papers.forEach(p => {
        const myAtt = attempts.filter(a => a.paper_id === p.id);
        const locked = !p.allow_multiple_attempts && myAtt.length > 0 && user.role !== 'admin';
        const pills = SUBJECTS
          .filter(s => (p.question_counts[s.id] || 0) > 0)
          .map(s => `<span class="px-2 py-0.5 rounded bg-slate-100 text-slate-700 text-[11px] font-medium">${s.short}: ${p.question_counts[s.id]}</span>`)
          .join('');

        const card = document.createElement('div');
        card.className = 'bg-white border border-slate-200 rounded-xl p-5 shadow-sm flex flex-col justify-between gap-4';
        card.innerHTML = `
          <div>
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-base font-bold text-slate-900">${p.title}</h3>
              <span class="shrink-0 text-xs font-semibold px-2 py-0.5 rounded bg-blue-50 text-blue-800">${p.duration_minutes} मि.</span>
            </div>
            <p class="text-xs text-slate-500 mt-1">एकूण ${p.total_questions} प्रश्न ${p.allow_multiple_attempts ? '• अनेकदा सराव' : '• एकच अटेम्प्ट'}</p>
            <div class="flex flex-wrap gap-1.5 mt-3">${pills || '<span class="text-xs text-slate-400">प्रश्न जोडलेले नाहीत</span>'}</div>
          </div>
          <div class="flex items-center justify-between pt-3 border-t border-slate-100">
            <span class="text-xs text-slate-500">${myAtt.length > 0 ? 'सोडवलेले: ' + myAtt.length + ' वेळा' : 'अजून सोडवले नाही'}</span>
            ${locked
              ? `<a href="report.html?attempt=${myAtt[0].id}" class="px-3.5 py-1.5 text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-lg">रिपोर्ट पाहा</a>`
              : `<a href="exam.html?paper=${p.id}" class="px-4 py-2 text-xs font-semibold bg-blue-900 hover:bg-blue-800 text-white rounded-lg">पेपर सुरू करा</a>`
            }
          </div>
        `;
        grid.appendChild(card);
      });
    })();
  </script>
</body>
</html>
