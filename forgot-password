<!DOCTYPE html>
<html lang="mr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>पासवर्ड बदला — पोलीस भरती सराव पोर्टल</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.49.1/dist/umd/supabase.min.js"></script>
  <link rel="stylesheet" href="styles.css" />
</head>
<body class="min-h-screen flex flex-col">

  <header class="bg-white border-b border-slate-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
      <a href="login.html" class="text-sm font-bold text-slate-900">← लॉगिन पेजवर परत जा</a>
      <a href="index.html" class="text-xs font-medium text-slate-600 hover:underline">मुख्य पेज</a>
    </div>
  </header>

  <main class="flex-1 flex items-center justify-center px-4 py-10">
    <div class="w-full max-w-md space-y-5">
      <div class="text-center">
        <h1 class="text-2xl font-bold text-slate-900">पासवर्ड विसरलात?</h1>
        <p class="text-xs text-slate-500 mt-1">तुमचा नोंदणीकृत मोबाईल नंबर आणि ईमेल व्हेरिफाय करून थेट नवीन पासवर्ड सेट करा</p>
      </div>

      <!-- Step 1: Verify Mobile + Email -->
      <form id="form-verify" class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm space-y-4">
        <div>
          <label for="fp-mobile" class="block text-xs font-semibold text-slate-700 mb-1">नोंदणीकृत मोबाईल नंबर</label>
          <input id="fp-mobile" type="tel" required pattern="[0-9]{10}" maxlength="10" placeholder="10 अंकी मोबाईल नंबर" class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-700" />
        </div>
        <div>
          <label for="fp-email" class="block text-xs font-semibold text-slate-700 mb-1">नोंदणीकृत ईमेल आयडी</label>
          <input id="fp-email" type="email" required placeholder="तुमचा ईमेल आयडी" class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-700" />
        </div>
        <button type="submit" class="w-full py-2.5 bg-blue-900 hover:bg-blue-800 text-white text-sm font-semibold rounded-lg transition-colors">
          डेटाबेसमध्ये तपासा (Verify)
        </button>
      </form>

      <!-- Step 2: Directly Enter New Password (No Email Link) -->
      <form id="form-reset" class="hidden bg-white border border-emerald-200 rounded-xl p-6 shadow-sm space-y-4">
        <div class="bg-emerald-50 border border-emerald-200 rounded-lg p-3 text-xs text-emerald-900 font-medium">
          ✓ तुमचा मोबाईल नंबर आणि ईमेल डेटाबेसशी जुळला आहे. आता खाली नवीन पासवर्ड टाका.
        </div>
        <div>
          <label for="fp-new-pass" class="block text-xs font-semibold text-slate-700 mb-1">नवीन पासवर्ड (किमान 6 अक्षरे)</label>
          <input id="fp-new-pass" type="password" required minlength="6" placeholder="नवीन पासवर्ड टाका" class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-700" />
        </div>
        <div>
          <label for="fp-confirm-pass" class="block text-xs font-semibold text-slate-700 mb-1">नवीन पासवर्ड पुन्हा टाका</label>
          <input id="fp-confirm-pass" type="password" required minlength="6" placeholder="पासवर्डची खात्री करा" class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-700" />
        </div>
        <button type="submit" class="w-full py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white text-sm font-semibold rounded-lg transition-colors">
          नवीन पासवर्ड अपडेट करा
        </button>
      </form>

      <!-- Step 3: Done -->
      <div id="reset-done" class="hidden bg-white border border-slate-200 rounded-xl p-6 text-center shadow-sm space-y-3">
        <h2 class="text-base font-bold text-emerald-800">पासवर्ड यशस्वीरित्या बदलला!</h2>
        <p class="text-xs text-slate-600">आता तुम्ही तुमच्या मोबाईल नंबर आणि नवीन पासवर्डने लॉगिन करू शकता.</p>
        <a href="login.html" class="inline-block px-5 py-2 text-xs font-semibold bg-blue-900 text-white rounded-lg hover:bg-blue-800">
          लॉगिन करा
        </a>
      </div>
    </div>
  </main>

  <script src="config.js"></script>
  <script>
    let verifiedMobile = '';
    let verifiedEmail = '';

    document.getElementById('form-verify').addEventListener('submit', async (e) => {
      e.preventDefault();
      const mob = document.getElementById('fp-mobile').value.trim();
      const em = document.getElementById('fp-email').value.trim();
      try {
        const matched = await api.verifyMobileEmail(mob, em);
        if (!matched) {
          showToast('हा मोबाईल नंबर आणि ईमेल डेटाबेसमध्ये सापडला नाही.');
          return;
        }
        verifiedMobile = mob;
        verifiedEmail = em;
        document.getElementById('form-verify').classList.add('hidden');
        document.getElementById('form-reset').classList.remove('hidden');
      } catch (err) {
        showToast(err.message);
      }
    });

    document.getElementById('form-reset').addEventListener('submit', async (e) => {
      e.preventDefault();
      const p1 = document.getElementById('fp-new-pass').value;
      const p2 = document.getElementById('fp-confirm-pass').value;
      if (p1 !== p2) {
        showToast('दोन्ही पासवर्ड सारखे नाहीत.');
        return;
      }
      try {
        await api.resetPasswordDirect(verifiedMobile, verifiedEmail, p1);
        document.getElementById('form-reset').classList.add('hidden');
        document.getElementById('reset-done').classList.remove('hidden');
        showToast('पासवर्ड अपडेट झाला!');
      } catch (err) {
        showToast(err.message);
      }
    });
  </script>
</body>
</html>
